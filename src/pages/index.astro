---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="KRSRAVEN">
  <section class="hero">
    <div class="hero__overlay"></div>
    <div class="hero__content">
      <h1 class="display-1 hero__title">AS THE RAVEN SAID...</h1>
      <p class="hero__verse">
        She saw white smoke rising on the endless wasteland,<br />
        witnessed Milia by the seaside holding a wave.<br />
        Do you wish to be friends with me, again?
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background:
      radial-gradient(ellipse at center, #2a2a2a 0%, #0a0a0a 100%);
    overflow: hidden;
  }
  .hero__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, var(--overlay-hero));
    pointer-events: none;
  }
  .hero__content {
    position: relative;
    z-index: 1;
    text-align: center;
    padding: 0 2rem;
    max-width: 900px;
  }
  .hero__title {
    color: #ffffff;
    margin-bottom: 2rem;
    text-transform: uppercase;
    opacity: 0;
    transform: translateY(24px);
    animation: heroRise 1.1s cubic-bezier(0.22, 0.61, 0.36, 1) 0.2s forwards;
  }
  .hero__verse {
    color: #e8e8e8;
    font-family: var(--font-body);
    font-size: 1.05rem;
    font-weight: 300;
    letter-spacing: 0.04em;
    line-height: 1.7;
    opacity: 0;
    transform: translateY(20px);
    animation: heroRise 2.4s cubic-bezier(0.22, 0.61, 0.36, 1) 1s forwards;
  }

  @keyframes heroRise {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__title,
    .hero__verse {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>
