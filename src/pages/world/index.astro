---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const entries = (await getCollection('world', ({ data }) => !data.draft))
  .sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999));
---

<BaseLayout title="World — KRSRAVEN">
  <section class="world-index">
    <h1 class="display-2">World</h1>
    <p class="world-index__lede">一个还在生长的 OC 世界观。</p>
    <ul class="world-index__list">
      {entries.map((e) => (
        <li class="world-index__item">
          <a href={`/world/${e.id}`}>
            <span class="world-index__kind">{e.data.kind}</span>
            <h2 class="world-index__title">{e.data.title}</h2>
            {e.data.description && (
              <p class="world-index__desc">{e.data.description}</p>
            )}
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  .world-index {
    max-width: 820px;
    margin: 0 auto;
    padding: calc(var(--nav-height) + 4rem) 1.5rem 6rem;
  }
  .world-index__lede {
    font-family: var(--font-serif);
    color: #555;
    margin: 1rem 0 3rem;
  }
  .world-index__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .world-index__item {
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--color-line);
  }
  .world-index__item a { display: block; }
  .world-index__kind {
    font-family: var(--font-body);
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .world-index__title {
    font-family: var(--font-serif);
    font-size: 1.4rem;
    margin: 0.4rem 0 0.5rem;
  }
  .world-index__desc {
    font-family: var(--font-serif);
    color: #555;
    margin: 0;
  }
  .world-index__item a:hover .world-index__title {
    text-decoration: underline;
  }
</style>
