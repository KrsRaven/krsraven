---
import BaseLayout from './BaseLayout.astro';
const { title, description } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <article class="wasteland">
    <div class="wasteland__inner">
      <h1 class="display-1 wasteland__title">{title}</h1>
      <div class="wasteland__body">
        <slot />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .wasteland {
    --wasteland-bg: #ece7dd;
    --wasteland-ink: #2a241c;
    min-height: 100vh;
    background: var(--wasteland-bg);
    color: var(--wasteland-ink);
    padding: calc(var(--nav-height) + 6rem) 1.5rem 6rem;
  }
  .wasteland__inner {
    max-width: 820px;
    margin: 0 auto;
  }
  .wasteland__title {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 3rem;
  }
  .wasteland__body {
    font-family: var(--font-serif);
    line-height: 2;
    font-size: 1.05rem;
  }
</style>
